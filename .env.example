SECRET_KEY=changeme

# URL que usa TCGWEB (backend Flask) para llamar a TCGAPI.
TCGAPI_BASE_URL=http://localhost:8080

# URL que el NAVEGADOR usa para pedir imágenes a TCGAPI directamente. Debe ser
# accesible desde tu PC. En local, igual que TCGAPI_BASE_URL. En Docker
# Compose, TCGAPI_BASE_URL pasa a ser el nombre del servicio (ej.
# "http://tcgapi:8080") y esta variable debe seguir apuntando a localhost.
TCGAPI_PUBLIC_URL=http://localhost:8080
